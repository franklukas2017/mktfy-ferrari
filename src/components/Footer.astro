---
// Footer.astro
---

<footer class="bg-canvas text-body text-body-sm py-xl px-lg border-t border-hairline">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-md">
    <div>
      <div class="font-bold text-display-md text-ink tracking-wider uppercase mb-xxs">
        Mktfy<span class="text-primary">.</span>
      </div>
      <p class="max-w-xs">Assessoria de Tráfego Pago e Performance. Focada em ROI e escala para o seu negócio.</p>
    </div>
    
    <div class="flex flex-col md:flex-row gap-sm md:gap-xl">
      <a href="#consultoria" class="hover:text-ink transition-colors">Solicitar Consultoria</a>
      <a href="#metodo" class="hover:text-ink transition-colors">Método</a>
      <a href="#resultados" class="hover:text-ink transition-colors">Resultados</a>
    </div>
  </div>
  <div class="max-w-6xl mx-auto mt-lg pt-md border-t border-hairline flex flex-col md:flex-row justify-between items-center text-caption text-muted">
    <p>&copy; {new Date().getFullYear()} Mktfy. Todos os direitos reservados.</p>
    <p class="mt-xxs md:mt-0">Feito com foco em performance.</p>
  </div>
</footer>
