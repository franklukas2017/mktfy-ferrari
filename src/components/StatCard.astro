---
// StatCard.astro
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="flex flex-col items-center justify-center p-md bg-transparent border-t border-hairline md:border-t-0 md:border-l first:border-t-0 first:border-l-0">
  <div class="text-number-display text-primary uppercase leading-none text-center">
    {value}
  </div>
  <div class="text-caption-uppercase text-ink mt-sm text-center">
    {label}
  </div>
</div>
