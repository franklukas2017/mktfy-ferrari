---
// Hero.astro
import { Image } from 'astro:assets';
import heroImage from '../assets/gerenciador-de-anuncios.jpg';
---

<section class="relative w-full pt-xxl pb-xl px-md md:px-lg bg-canvas border-b border-hairline">
  <div class="relative z-20 w-full max-w-[1280px] mx-auto text-center">
    <div class="max-w-4xl mx-auto mb-xl">
      <h1 class="text-display-md sm:text-display-lg md:text-display-mega text-ink mb-md uppercase leading-tight md:leading-[1.05]">
        Sua verba de anúncios merece <span class="text-primary">resultado.</span> Não promessas.
      </h1>
      <p class="text-body-md text-body mb-lg max-w-2xl mx-auto">
        Assessoria de tráfego pago personalizada que já gerou R$ 10 milhões em vendas com atendimento direto e estratégias sob medida.
      </p>
      <div class="flex justify-center mt-lg md:mt-0">
        <a href="#consultoria" class="bg-primary text-on-primary text-button px-sm md:px-xl py-[14px] uppercase rounded-none hover:bg-primary-active transition-colors h-12 inline-flex items-center justify-center w-full md:w-auto">
          Solicitar Consultoria Gratuita
        </a>
      </div>
    </div>
    
    <div class="w-full max-w-5xl mx-auto rounded-none border border-hairline bg-canvas-elevated p-xxs relative overflow-hidden shadow-2xl">
      <div class="relative w-full aspect-[16/9] overflow-hidden bg-black">
        <Image 
          src={heroImage} 
          alt="Dashboard de Resultados" 
          class="w-full h-full object-cover object-top opacity-90"
          fetchpriority="high"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
